. * Set cutoffs at specified percentiles in list above
. foreach t of numlist `list' {
  2.         foreach x of varlist actual pmt {
  3.                 _pctile `x' [aw=$weight] , p(`t') // here we calculate the percentile value of actual and pmt
  4.                 cap drop cut_`x'_`t'  poor_`x'_`t' 
  5.                 g cut_`x'_`t'=r(r1)  // here we define the cutoffs 
  6.                 g poor_`x'_`t'= (`x'<=cut_`x'_`t')  // here we define everyone who has a score below the cutoff as poor
  7.         }
  8. }

. 
. * Simpler format to calculate targeting perofrmance (if we dont need to calculate standard errors for example)
. svyset, clear

. 
.         
. preserve

. 
. foreach t of numlist `list' {
  2. 
.         qui cap drop poor_pmtpoor_`t' nonpoor_pmtpoor_`t' poor_pmtnonpoor_`t' nonpoor_pmtnonpoor_`t'
  3.                 
.         qui g fpoor_pmtpoor_`t'         =       poor_actual_`t' == 1 & poor_pmt_`t'==1 // Household is actually poor and pmt predicted poor
  4.         qui g fnonpoor_pmtpoor_`t'      =       poor_actual_`t' == 0 & poor_pmt_`t'==1 // Household is not poor but pmt predicted poor
  5.         qui g fpoor_pmtnonpoor_`t'      =       poor_actual_`t' == 1 & poor_pmt_`t'==0 // Household is actually poor but pmt predicted not poor
  6.         qui g fnonpoor_pmtnonpoor_`t'=  poor_actual_`t' == 0 & poor_pmt_`t'==0 // Household is not poor and pmt predicted not poor
  7.         
.         qui g ftotalaccuracy`t' = ((fpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t'+fnonpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')) // (correc
> tly predicted poor + correctly pred nonpoor)/ Total sample size
  8.         qui g fpovertyaccuracy`t'  = (fpoor_pmtpoor_`t'/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t')) // (correctly predicted poor) / (all poor)
  9.         qui g fnpovertyaccuracy`t' = (fnonpoor_pmtnonpoor_`t'/(fnonpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')) // (correctly predicted not poor) / (all non poor)
 10.         qui g fundercoverage`t'    = (fpoor_pmtnonpoor_`t'/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t'))  // (poor but predicted not poor PMT) / (all true poor)
 11.         qui g finclusionerror`t'   = (fnonpoor_pmtpoor_`t'/(fpoor_pmtpoor_`t'+fnonpoor_pmtpoor_`t')) // (not poor but PMT predicted poor) / (all PMT pred poor)
 12.         
. }

