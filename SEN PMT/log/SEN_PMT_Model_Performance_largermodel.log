 opened on:   1 Jun 2025, 15:30:33

. 
. use "$data/data4model_2021_IMPUTED_largermodel.dta", clear

. 
. global weight popweight

. global lnwelfare lpcexp

. global welfare pcexp

. 
. twoway kdensity lpcexp_pred [aw=$weight] || kdensity lpcexp_pred if b40==1 [aw=$weight], legend(on order(1 "All HBS" 2 "Bottom 40% HBS")) title("National HBS (Larger Urb-Rur Mo
> dels): Distribution of Predicted Log Expenditure (PMT scores)", size(small)) 

. gr save "$results/HBS_pmtscore_distribution_largermodels.gph",  replace
(file /Users/jeremyschneider/Desktop/SEN PMT/results/HBS_pmtscore_distribution_largermodels.gph not found)
file /Users/jeremyschneider/Desktop/SEN PMT/results/HBS_pmtscore_distribution_largermodels.gph saved

. 
. gen samplesize = _N

. xtile decile = $lnwelfare [aw=$weight], nq(10)

. 
. gen actual = pcexp

. gen pmt = pcexp_pred

. 
. local list "15 18 20 30 37 40"

. 
. * Set cutoffs at specified percentiles in list above
. foreach t of numlist `list' {
  2.         foreach x of varlist actual pmt {
  3.                 _pctile `x' [aw=$weight] , p(`t') // here we calculate the percentile value of actual and pmt
  4.                 cap drop cut_`x'_`t'  poor_`x'_`t' 
  5.                 g cut_`x'_`t'=r(r1)  // here we define the cutoffs 
  6.                 g poor_`x'_`t'= (`x'<=cut_`x'_`t')  // here we define everyone who has a score below the cutoff as poor
  7.         }
  8. }

. 
. 
. foreach truepoor in poor_actual_20 poor_actual_37 {
  2.         
.         preserve
  3. 
.         foreach t of numlist `list' {
  4.         
.                 qui cap drop poor_pmtpoor_`t' nonpoor_pmtpoor_`t' poor_pmtnonpoor_`t' nonpoor_pmtnonpoor_`t'
  5.                         
.                 qui g fpoor_pmtpoor_`t'         =       `truepoor' == 1 & poor_pmt_`t'==1 // Household is actually poor and pmt predicted poor
  6.                 qui g fnonpoor_pmtpoor_`t'      =       `truepoor' == 0 & poor_pmt_`t'==1 // Household is not poor but pmt predicted poor
  7.                 qui g fpoor_pmtnonpoor_`t'      =       `truepoor' == 1 & poor_pmt_`t'==0 // Household is actually poor but pmt predicted not poor
  8.                 qui g fnonpoor_pmtnonpoor_`t'=  `truepoor' == 0 & poor_pmt_`t'==0 // Household is not poor and pmt predicted not poor
  9.                 
.                 qui g ftotalaccuracy`t' = ((fpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t'+fnonpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')) //
>  (correctly predicted poor + correctly pred nonpoor)/ Total sample size
 10.                 qui g fpovertyaccuracy`t'  = (fpoor_pmtpoor_`t'/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t')) // (correctly predicted poor) / (all poor)
 11.                 qui g fnpovertyaccuracy`t' = (fnonpoor_pmtnonpoor_`t'/(fnonpoor_pmtpoor_`t'+fnonpoor_pmtnonpoor_`t')) // (correctly predicted not poor) / (all non poor)
 12.                 qui g fundercoverage`t'    = (fpoor_pmtnonpoor_`t'/(fpoor_pmtpoor_`t'+fpoor_pmtnonpoor_`t'))  // (poor but predicted not poor PMT) / (all true poor)
 13.                 qui g finclusionerror`t'   = (fnonpoor_pmtpoor_`t'/(fpoor_pmtpoor_`t'+fnonpoor_pmtpoor_`t')) // (not poor but PMT predicted poor) / (all PMT pred poor)
 14.                 
.         }
 15. 
.         fsum ftotalaccuracy* fpovertyaccuracy* fnpovertyaccuracy* fundercoverage* finclusionerror*  [aw=$weight] 
 16.         
.         keep fundercoverage* finclusionerror*  $weight
 17.         collapse (mean) fundercoverage* finclusionerror*   [pw=$weight] 
 18. 
.         save "$results/SEN2021_SWIFTPMT_targeting_natl_large_performance_`truepoor'.dta",replace
 19. 
. 
.         restore
 20. }

